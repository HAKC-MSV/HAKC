+#if IS_ENABLED(CONFIG_HAKC)
+static void percpu_modcopy_ptr(void *__percpu ptr, const void *from,
+				unsigned long size)
+{
+	int cpu;
+
+	if (size == 0)
+		return;
+
+	for_each_possible_cpu(cpu)
+		memcpy(per_cpu_ptr(ptr, cpu), from, size);
