{
  # See HAKCPolicyProcessConfig in llvm-project/llvm/utils/hakc/hakc/HAKCPolicyServer.py
  "backing_policy_config": {
    # See SupportedBackingStore in llvm-project/llvm/utils/hakc/hakc/HAKCPolicyServer.py
    "type": "kuzu",
    "path": "@linux_build_path@/hakc-db",
    "default_compartment": 0,
    "default_division": 0
  },
  "socket_path": "@CMAKE_BINARY_DIR@/db-socket",
  "reuse_path": true,
  "test-mode": false,
  "server_timeout": 100,
  "dag_path": "@linux_build_path@/linux_kernel_dag.yml",
  "get-compartment-by-id-endpoint": "get-compartment-by-id",
  "get-division-by-id-endpoint": "get-division-by-id",
  "get-division-from-symbol-endpoint": "get-division-from-symbol",
  "get-valid-targets-from-compartment-id-endpoint": "get-valid-targets-from-compartment-id",
  "set-dag-filename-endpoint": "set-dag-filename",
  "add-function-endpoint": "add-function",
  "add-global-variable-endpoint": "add-global-variable",
  "terminate-connection-endpoint": "terminate-connection"
}
