@CMAKE_SOURCE_DIR@/linux/scripts/config --file @linux_build_dir@/.config \
-e CONFIG_HAKC --set-str CONFIG_HAKC_CONFIG_PATH @hakc_build_dir@/hakc-config.yaml -e CONFIG_DEBUG_INFO_DWARF5 \
-d CONFIG_DEBUG_INFO_NONE -e CONFIG_DEBUG_INFO -e CONFIG_DEBUG_INFO_COMPRESSED_NONE \
-d CONFIG_DEBUG_INFO_COMPRESSED_ZLIB -d CONFIG_DEBUG_INFO_COMPRESSED_ZSTD -d CONFIG_DEBUG_INFO_REDUCED \
-e CONFIG_DEBUG_INFO_SPLIT -e CONFIG_GDB_SCRIPTS -e CONFIG_HAKC_ALLOW_FAILED -e CONFIG_HAKC_DEBUG_PRINT \
-d CONFIG_HAKC_DEMO_LEAK -d CONFIG_HAKC_LOG_FAILURE -e CONFIG_HAKC_X86 \
-e CONFIG_HAKC_X86_MEMORY -e CONFIG_HAKC_X86_SIGN_NI -m CONFIG_KVM -m CONFIG_KVM_INTEL \
-d CONFIG_LOCALVERSION_AUTO -d CONFIG_UBSAN --set-val CONFIG_FRAME_WARN 16384 \
-d CONFIG_SECURITY_LOCKDOWN_LSM \
--set-str CONFIG_SYSTEM_TRUSTED_KEYS "" --set-str CONFIG_SYSTEM_REVOCATION_KEYS "" -d CONFIG_MODULE_SIG \
-d CONFIG_HAVE_ARCH_KASAN -d CONFIG_HAVE_ARCH_KASAN_VMALLOC -d CONFIG_CC_HAS_KASAN_GENERIC \
-d CONFIG_CC_HAS_WORKING_NOSANITIZE_ADDRESS -d CONFIG_KASAN -d CONFIG_HAVE_ARCH_KMSAN \
-d CONFIG_JUMP_LABEL
