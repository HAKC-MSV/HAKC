# the root config called by both the server and client
build-path:                 "@hakc_build_path@"
server-config-path:         "@hakc_server_config_path@"
client-config-path:         "@hakc_client_config_path@"
socket-path:                "@hakc_socket_path@"
log-path:                   "@hakc_log_path@"
build-mode:                 "@hakc_build_mode@"
pass-mode:                  "@hakc_pass_mode@"
server-core-count:          @hakc_server_core_count@
default-compartment-id:     0
default-division-id:        53
default-access-token:       5353
default-entry-token:        3535
Endpoints:
    get-compartment-by-id-endpoint:                 "get-compartment-by-id"
    get-division-by-id-endpoint:                    "get-division-by-id"
    get-division-from-symbol-endpoint:              "get-division-from-symbol"
    get-valid-targets-from-compartment-id-endpoint: "get-valid-targets-from-compartment-id"
    add-symbols-endpoint:                           "add-symbols"
    terminate-connection-endpoint:                  "terminate-connection"
