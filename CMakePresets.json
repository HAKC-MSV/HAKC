{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "LLVM_ENABLE_PROJECTS": "clang;clang-tools-extra;lld",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "LLVM_TARGETS_TO_BUILD": "X86;AArch64;ARM",
        "LLVM_USE_LINKER": "lld",
        "LLVM_ENABLE_HAKC": "ON",
        "LLVM_BUILD_TESTS": "ON",
        "LLVM_ENABLE_ASSERTIONS": "ON",
        "HAKC_PYTHON_VENV": "${sourceDir}/python/venv"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "description": "Release build configuration",
      "binaryDir": "${sourceDir}/cmake-build-hakc-release",
      "installDir": "release-install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-release",
      "inherits": "base",
      "description": "Release CI build configuration",
      "binaryDir": "${sourceDir}/cmake-build-hakc-release",
      "installDir": "install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LLVM_DISABLE_LOGF128": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "description": "Debug build configuration",
      "binaryDir": "${sourceDir}/cmake-build-hakc",
      "installDir": "debug-install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "hakc+msv",
      "inherits": "base",
      "description": "HAKC+MSV configuration",
      "binaryDir": "${sourceDir}/cmake-build-hakc+msv",
      "installDir": "hakc+msv-install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_C_COMPILER": "clang-14",
        "CMAKE_CXX_COMPILER": "clang++-14"
      }
    }
  ]
}
