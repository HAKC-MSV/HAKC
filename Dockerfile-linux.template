FROM ett-jfrog.llan.ll.mit.edu/isd-docker-local/ubuntu:latest
RUN apt -y update && apt install -y $DEPS_TO_INSTALL \
    && apt clean all && rm -rf /var/cache/apt/archives /var/lib/apt/lists/*
ADD $INSTALL_DIR/hakc-kernel /opt/hakc-linux
ADD $INSTALL_DIR/rootfs.img /opt/hakc-linux
COPY ./hakc /opt/hakc
CMD ["/bin/bash"]
